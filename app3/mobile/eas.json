{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_IAP_PRODUCT_ID": "com.beenages.app.fullpack",
        "EXPO_PUBLIC_IAP_SIMULATE": "1"
      }
    },
    "preview-ios-sim": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_IAP_PRODUCT_ID": "com.beenages.app.fullpack"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "TBD"
      }
    }
  }
}
