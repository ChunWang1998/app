{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_IAP_PRODUCT_ID": "com.linwang.app.premium",
        "EXPO_PUBLIC_IAP_SIMULATE": "1"
      }
    },
    "preview-ios-sim": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_IAP_PRODUCT_ID": "com.linwang.app.premium",
        "EXPO_PUBLIC_IAP_SIMULATE": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_IAP_PRODUCT_ID": "com.linwang.app.premium"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "11165497037"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
