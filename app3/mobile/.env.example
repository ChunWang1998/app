# Project URL = https://xxxx.supabase.co  (不要加 /rest/v1/)
# Key = anon 或 publishable
#
# 本機 `expo start` 讀這個檔。
# EAS preview / production 不會帶本機 .env，必須 push 同名變數後再建置：
#   npm run eas:env:push:preview
#   npm run eas:env:push:production
#   npm run eas:env:list
#
# 設好後到 Dashboard → SQL Editor 執行 app3/supabase/schema.sql
# 未設定時，試用版用本機 AsyncStorage（白名單僅本機，無法跨裝置）。

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
