# Example environment variables for Been Ages (no secrets)
# Copy to .env and adjust as needed. Do NOT commit .env.

# One-time IAP product id (non-secret)
EXPO_PUBLIC_IAP_PRODUCT_ID=com.beenages.app.fullpack

# Free tier item limit
EXPO_PUBLIC_FREE_ACTIVITY_LIMIT=10

# Preview-only IAP simulation flag (must NOT be enabled in production)
# EXPO_PUBLIC_IAP_SIMULATE=1

# Meta App ID for direct IG Stories (leave empty; v1.1 uses the system share sheet)
# EXPO_PUBLIC_META_APP_ID=
