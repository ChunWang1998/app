{
  "expo": {
    "name": "Been Ages",
    "slug": "been-ages",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beenages.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "sdkVersion"
      }
    },
    "android": {
      "package": "com.beenages.app",
      "permissions": []
    },
    "plugins": [
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "zh-Hant"
            ],
            "android": [
              "en",
              "zh-Hant",
              "zh-TW",
              "zh-HK"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "expo-iap",
      "expo-sharing"
    ],
    "locales": {
      "en": "./languages/en.json",
      "zh-Hant": "./languages/zh-Hant.json",
      "zh-TW": "./languages/zh-Hant.json",
      "zh-HK": "./languages/zh-Hant.json"
    },
    "extra": {
      "eas": {
        "projectId": "33ece313-8cae-4778-8ec5-e483fc9bf204"
      }
    },
    "owner": "leowang1105"
  }
}
