{
  "expo": {
    "name": "Been Ages",
    "slug": "been-ages",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "beenages",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beenages.app",
      "buildNumber": "1",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.beenages.app"
        ]
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "sdkVersion"
      }
    },
    "android": {
      "package": "com.beenages.app",
      "permissions": []
    },
    "plugins": [
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "zh-Hant"
            ],
            "android": [
              "en",
              "zh-Hant",
              "zh-TW",
              "zh-HK"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "expo-iap",
      "expo-sharing",
      [
        "expo-calendar",
        {
          "writeOnlyAccess": true,
          "calendarPermission": false,
          "remindersPermission": false,
          "writeOnlyCalendarPermission": "Adds an item's next due date to your calendar."
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.beenages.app.widget",
          "groupIdentifier": "group.com.beenages.app",
          "widgets": [
            {
              "name": "BeenAgesHome",
              "displayName": "Been Ages",
              "description": "How long since last time. Tap ✓ to log.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "configuration": {
                  "title": "Been Ages",
                  "description": "Leave blank for the most-due item.",
                  "parameters": {
                    "itemId": {
                      "title": "Item",
                      "type": "string",
                      "default": "auto"
                    }
                  }
                }
              }
            },
            {
              "name": "BeenAgesLock",
              "displayName": "Been Ages",
              "description": "Days on the Lock Screen.",
              "ios": {
                "supportedFamilies": ["accessoryCircular", "accessoryRectangular"],
                "configuration": {
                  "title": "Been Ages",
                  "parameters": {
                    "itemId": {
                      "title": "Item",
                      "type": "string",
                      "default": "auto"
                    },
                    "hideNames": {
                      "title": "Hide names",
                      "type": "boolean",
                      "default": false
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    ],
    "locales": {
      "en": "./languages/en.json",
      "zh-Hant": "./languages/zh-Hant.json",
      "zh-TW": "./languages/zh-Hant.json",
      "zh-HK": "./languages/zh-Hant.json"
    },
    "extra": {
      "eas": {
        "projectId": "33ece313-8cae-4778-8ec5-e483fc9bf204"
      }
    },
    "owner": "leowang1105"
  }
}
