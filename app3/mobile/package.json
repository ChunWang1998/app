{
  "name": "been-ages",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "build:ios:preview": "eas build --platform ios --profile preview-ios-sim",
    "build:ios": "eas build --platform ios --profile production",
    "deploy:testflight": "eas build --platform ios --profile production --auto-submit",
    "eas:env:push:preview": "eas env:push preview --path .env --force",
    "eas:env:push:production": "eas env:push production --path .env --force",
    "eas:env:list": "eas env:list preview && eas env:list production"
  },
  "dependencies": {
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.0",
    "expo-constants": "~57.0.20",
    "expo-iap": "^5.3.1",
    "expo-localization": "~57.0.2",
    "expo-notifications": "57.0.22",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "@types/jest": "^29.5.14"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.expo/",
      "<rootDir>/.expo-shared/"
    ]
  }
}
