{
  "name": "been-ages",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "build:ios:preview": "eas build --platform ios --profile preview-ios-sim",
    "build:ios": "eas build --platform ios --profile production",
    "deploy:testflight": "eas build --platform ios --profile production --auto-submit",
    "eas:env:push:preview": "eas env:push preview --path .env --force",
    "eas:env:push:production": "eas env:push production --path .env --force",
    "eas:env:list": "eas env:list preview && eas env:list production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.1.7",
    "apple-foundation-models": "file:./modules/apple-foundation-models",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.30",
    "expo-build-properties": "57.0.22",
    "expo-calendar": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-iap": "^5.3.1",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-sharing": "~57.0.23",
    "expo-speech-recognition": "57.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "braces": ">=3.0.3",
    "node-forge": "^1.3.1",
    "argparse": "^2.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "audit-ci": "^7.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.expo/",
      "<rootDir>/.expo-shared/"
    ]
  },
  "scriptsExtra": {
    "export:web": "npx expo export --platform web",
    "font:check": "node scripts/check-font-coverage.js"
  },
  "ciScripts": {
    "auditHigh": "npx audit-ci --config audit-ci.json"
  }
}
