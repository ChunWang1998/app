# Project URL = https://xxxx.supabase.co  (不要加 /rest/v1/)
# Dashboard → SQL Editor 執行 app4/supabase/schema.sql
#
# 本機 `expo start` 讀這個檔。
# EAS preview / production 必須 push 同名變數後再建置：
#   npm run eas:env:push:preview
#   npm run eas:env:push:production
#
# 未設定時走本機 AsyncStorage + 示範候選人（僅供 UI 測試）。

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# iOS IAP（production eas.json 已內建）
# EXPO_PUBLIC_IAP_PRODUCT_ID=com.identitymatch.app.premium
