{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_IAP_PRODUCT_ID": "com.identitymatch.app.premium",
        "EXPO_PUBLIC_IAP_SIMULATE": "1"
      }
    },
    "preview-ios-sim": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_IAP_PRODUCT_ID": "com.identitymatch.app.premium",
        "EXPO_PUBLIC_IAP_SIMULATE": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_IAP_PRODUCT_ID": "com.identitymatch.app.premium"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
