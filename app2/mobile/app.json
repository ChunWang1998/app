{
  "expo": {
    "name": "急廁 Go",
    "slug": "toilet-go",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toiletgo.app",
      "buildNumber": "22",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSLocationWhenInUseUsageDescription": "Your location is used to find nearby stores and cafes with a toilet.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "comgooglemaps"
        ]
      }
    },
    "android": {
      "package": "com.toiletgo.app",
      "adaptiveIcon": {
        "backgroundColor": "#252526",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to find nearby stores and cafes with a toilet."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "ja",
              "zh-Hant"
            ],
            "android": [
              "en",
              "ja",
              "zh-Hant",
              "zh-TW",
              "zh-HK"
            ]
          }
        }
      ],
      "expo-font",
      "expo-file-system",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8FBF7",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      "expo-iap"
    ],
    "locales": {
      "en": "./languages/en.json",
      "ja": "./languages/ja.json",
      "zh-Hant": "./languages/zh-Hant.json",
      "zh-HK": "./languages/zh-Hant.json",
      "zh-TW": "./languages/zh-Hant.json"
    },
    "extra": {
      "eas": {
        "projectId": "bc9c70d1-9edd-4380-aad4-172c45eb4fca"
      }
    },
    "owner": "leowang1105"
  }
}
