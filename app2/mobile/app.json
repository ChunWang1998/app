{
  "expo": {
    "name": "急廁 Go",
    "slug": "toilet-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8FBF7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.superpredict.toiletgo",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "需要你的位置來找出附近有廁所的超商／咖啡廳。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8FBF7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "package": "com.superpredict.toiletgo"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "需要你的位置來找出附近有廁所的超商／咖啡廳。"
        }
      ]
    ]
  }
}
