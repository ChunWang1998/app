# Project URL = https://xxxx.supabase.co  (不要加 /rest/v1/)
# Key = anon 或 publishable

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional: remote places CDN (serves /cells/{i}_{j}.json).
# If unset, mobile uses bundled cellRegistry (offline). For production at scale, host
# the output of buildDataSet.py (web/public/places or data/dist) and set this URL.
# Example while running Vite: EXPO_PUBLIC_PLACES_URL=http://192.168.x.x:5173/places
# EXPO_PUBLIC_PLACES_URL=
