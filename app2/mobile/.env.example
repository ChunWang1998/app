# Project URL = https://xxxx.supabase.co  (不要加 /rest/v1/)
# Key = anon 或 publishable

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Remote places CDN (serves /cells/{i}_{j}.json and /cities/{縣市}.json).
# If unset, mobile uses bundled cellRegistry (offline fallback).
# For production, host data/dist/ on any static host and set this URL.
#
# GitHub Pages:  EXPO_PUBLIC_PLACES_URL=https://chunwang1998.github.io/app/places
# Vite local:    EXPO_PUBLIC_PLACES_URL=http://192.168.x.x:5173/places
EXPO_PUBLIC_PLACES_URL=https://chunwang1998.github.io/app/places
