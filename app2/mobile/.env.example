# Project URL = https://xxxx.supabase.co  (不要加 /rest/v1/)
# Key = anon 或 publishable

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Remote places CDN (serves /cells/{i}_{j}.json, /cities/{縣市}.json, /manifest.json).
# Pro pack: /pack/full.json + /pack/manifest.json (buyout offline unlock).
# Cells are fetched on demand and cached on device (expo-file-system).
# If unset, mobile uses a tiny bundled hotspot in cellRegistry (高雄示範 9 格).
# For production, host data/dist/ on any static host and set this URL.
#
# GitHub Pages:  EXPO_PUBLIC_PLACES_URL=https://chunwang1998.github.io/app/places
# Vite local:    EXPO_PUBLIC_PLACES_URL=http://192.168.x.x:5173/places
EXPO_PUBLIC_PLACES_URL=https://chunwang1998.github.io/app/places

# Apple / Google non-consumable product id for full offline pack unlock.
EXPO_PUBLIC_IAP_PRODUCT_ID=com.toiletgo.app.pro
# Force simulated buy in any build (optional). Expo Go always simulates.
# EXPO_PUBLIC_IAP_SIMULATE=1
